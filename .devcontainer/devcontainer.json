{
    "name": "Ubuntu",
    "build": {
        "context": "..",
        "dockerfile": "../Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "platformio.platformio-ide",
                "ms-vscode.cpptools"
            ]
        }
    },
    "mounts": [
        "source=/dev,target=/dev,type=bind,bind-propagation=shared"
    ],
    "privileged": true,
    "postStartCommand": "echo \"{\\\"terminal.integrated.shell.linux\\\": \\\"/bin/bash\\\",\\\"platformio-ide.useBuiltinPython\\\" false,\\\"platformio-ide.useBuiltinPIOCore\\\": false,\\\"platformio-ide.customPath\\\": \\\"/root/.platformino/penv/bin\\\"}\" > /root/.vscode-server/data/Machine/settings.json"
}